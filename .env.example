# Firebase – get these from Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Optional: shared password to unlock the app (event staff only). If set, users must enter it to see the app.
# VITE_APP_PASSWORD=your-event-password
# Optional: hint shown under "Demo Credentials" on the login screen (e.g. test123). If unset, shows "Ask your event organizer".
# VITE_APP_PASSWORD_HINT=test123

# If Firebase vars are empty, the app falls back to localStorage (no real-time sync).
